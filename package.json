{
  "name": "grup3APIREST",
  "module": "server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun --env-file=secrets.env run server.ts",
    "dev": "bun --env-file=secrets.env --watch run server.ts",
    "seed": "bun --env-file=secrets.env run scripts/seed.ts",
    "seed:clean": "bun --env-file=secrets.env run scripts/seed.ts --clean"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
